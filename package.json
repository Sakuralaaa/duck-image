{
  "name": "duck-image",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "CPA-style OpenAI-compatible gateway for Duck.ai: chat/completions, responses, models, web search, reasoning effort and image generation.",
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:web": "vite build --config webapp/vite.config.ts --configLoader native",
    "build:exe": "node scripts/build-exe.mjs",
    "build:bin": "node scripts/build-exe.mjs",
    "build:linux-x64": "node scripts/build-exe.mjs --target=bun-linux-x64",
    "build:linux-x64-musl": "node scripts/build-exe.mjs --target=bun-linux-x64-musl",
    "build:linux-arm64": "node scripts/build-exe.mjs --target=bun-linux-arm64",
    "build:darwin-x64": "node scripts/build-exe.mjs --target=bun-darwin-x64",
    "build:darwin-arm64": "node scripts/build-exe.mjs --target=bun-darwin-arm64",
    "dev:web": "vite --config webapp/vite.config.ts --configLoader native",
    "preview:web": "vite preview --config webapp/vite.config.ts --configLoader native",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview",
    "smoke": "node scripts/smoke.js",
    "test": "node --test --test-isolation=none --test-concurrency=1 \"tests/*.test.js\"",
    "test:watch": "node --test --watch --test-isolation=none --test-concurrency=1 \"tests/*.test.js\""
  },
  "keywords": [
    "duck.ai",
    "cpa",
    "openai-compatible",
    "gateway",
    "responses-api"
  ],
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fastify": "^5.12.8",
    "gpt-tokenizer": "^2.9.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "socks": "^2.8.10",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "openai": "^7.47.0",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
